# ==============================================================================
# Qubit Crew Backend Environment Configuration Template
# Copy this file to .env and configure according to your deployment environment.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
RELOAD=false

# Quantum Simulator Settings
# Options: qiskit_aer (recommended high-performance classical simulator)
QUANTUM_SIMULATOR_BACKEND=qiskit_aer
DEFAULT_SHOTS=1000
DEFAULT_ANOMALY_THRESHOLD=0.05

# Classical Cryptography Configuration
SIGNATURE_ALGORITHM=ECDSA-secp256r1-SHA256
HASH_ALGORITHM=SHA-256

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Logging & Telemetry
LOG_LEVEL=INFO
